class Solution:
    def smallestStableIndex(self, nums, k):
        n = len(nums)

        suffixMin = [0] * n
        suffixMin[-1] = nums[-1]

        for i in range(n - 2, -1, -1):
            suffixMin[i] = min(nums[i], suffixMin[i + 1])

        prefixMax = nums[0]

        for i in range(n):
            prefixMax = max(prefixMax, nums[i])

            if prefixMax - suffixMin[i] <= k:
                return i

        return -1
